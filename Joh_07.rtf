808? \u1815?\u1864?\u1821? \u1816?\u1842?\u1810?\u1858?\u1835?\u1842?\u1810?\u1857?\u1836?\u1858?\u1845?\u1808? \u1811?\u1857?\u1845?\u1817?\u1834?\u1821?\u1852?\u1826? \u1808?\u1826?\u1864?\u1836?\u1857?\u1816?\u1855?\u1826? \u1810?\u1857?\u1842?\u1834?\u1826?\u1845?\u1835?\u1845?\u1808? \u1792?\lang1048\f3\line\f0\fs24 22 m\u234?\u7791?\u363?l h\u257?n\u257?e Mu\u333?\'ba\u234?e i\u275?h\'e2v l\'ee\'b7cu\u333?n \u289?\'e2zor\'ee\'b7\u7789?\u257?e l\u257?e hu\u257?e m\u234?\u7791?\u363?l \u7693?\'ee\'b7m\u234?n\u234?\'b7h\'ee hyi m\u275?n Mu\u333?\'ba\u234?e e\u234?l\u257?e \u7693?\'ee\'b7m\u275?n e\u275?b\u257?h\u257?\'b7t\u257?e hyi u\u275?\'b7v\'ee\'b7\'ba\u275?\u7685?\'e2t\u257?e \u289?\u257?zryin e\u275?n\'e2\u7789?u\u333?n \u7685?\u275?\'b7r\'e2n\u257?\'ba\u257?e .\line Pentru aceasta Mo\'bae dat vou\'e3 circumcizie\cf2\up8  Lev 12:3\cf0\up0  nu este pentru de-aceasta-i ea din Mo\'bae ci dintre p\'e3rin\'feime ea \'bai \'baabatirei circumcide\'fei\cf2\up8  Gen 17:1-27; 21\cf0\up0  voi \'een oamenire.\line\~ \line\lang1114\f1\fs27\u1808?\u1848?\u1826? \u1810?\u1857?\u1842?\u1834?\u1826?\u1845?\u1835?\u1845?\u1808? \u1825?\u1848?\u1836?\u1858?\u1811?\u1857?\u1817?\u1842?\u1834? \u1810?\u1857?\u1821?\u1842?\u1816?\u1825?\u1845?\u1808? \u1813?\u1857?\u1835?\u1842?\u1810?\u1857?\u1836?\u1858?\u1845?\u1808? \u1825?\u1848?\u1819?\u1852?\u1824? \u1813?\u1857?\u1824?\u1845?\u1808? \u1826?\u1848?\u1835?\u1836?\u1857?\u1834?\u1849?\u1808? \u1826?\u1845?\u1825?\u1816?\u1855?\u1827?\u1845?\u1808? \u1813?\u1857?\u1825?\u1816?\u1855?\u1835?\u1849?\u1808? \u1829?\u1824?\u1842?\u1821? \u1834?\u1845?\u1819?\u1826?\u1821?\u1852?\u1826? \u1808?\u1826?\u1864?\u1836?\u1857?\u1816?\u1855?\u1826? \u1813?\u1857?\u1823?\u1858?\u1852?\u1824?\u1849?\u1815? \u1810?\u1857?\u1842?\u1834?\u1826?\u1845?\u1835?\u1845?\u1808? \u1808?\u1842?\u1818?\u1824?\u1825?\u1848?\u1836?\u1858? \u1810?\u1857?\u1821?\u1842?\u1816?\u1825?\u1845?\u1808? \u1813?\u1857?\u1835?\u1842?\u1810?\u1857?\u1836?\u1858?\u1845?\u1808? \u1792?\lang1048\f3\line\f0\fs24 23 e\u234?n \u7685?\u275?\'b7r\'e2n\u257?\'ba\u257?e m\u234?t\'b7\u289?\'e2z\u275?r \u7685?\'ee\'b7i\u275?um\u257?e \u7693?\'ee\'b7\'ba\u275?\u7685?\'e2t\u257?e m\u234?\u7791?\u363?l \u7693?\'ee\'b7l\u257?e n\u234?\'ba\u7789?r\u234?e \'b7N\u257?\'b7Mu\u333?s\u257?e \u7693?\'ee\'b7Mu\u333?\'ba\u234?e al\u275?\'b7i r\u257?\u7791?nyin e\u275?n\'e2\u7789?u\u333?n \u7693?\'ee\'b7c\u363?l\u234?\'b7h\'ee \u7685?\u275?\'b7r\'e2n\u257?\'ba\u257?e e\u275?\u7717?\'e2l\'e2m\u234?t \u7685?\'ee\'b7i\u275?um\u257?e \u7693?\'ee\'b7\'ba\u275?\u7685?\'e2t\u257?e .\line Dac\'e3 \'een omenire s-ar circumcide \'een zi de sabat, pentru deloc va-nc\'e3lca Profet-Moise de Mo\'bae, peste-Mi m\'e2nia\'fei voi de-ntregire-i \'een omenire s\'e3n\'e3tos \'een zi de sabat?\line\line\lang1114\f1\fs27\u1824?\u1845?\u1808? \u1836?\u1857?\u1849?\u1815?\u1816?\u1816?\u1855?\u1826? \u1813?\u1857?\u1845?\u1821?\u1826?\u1821?\u1852?\u1826? \u1810?\u1857?\u1825?\u1842?\u1827?\u1842?\u1810?\u1858? \u1810?\u1857?\u1842?\u1808?\u1830?\u1857?\u1849?\u1808? \u1808?\u1848?\u1824?\u1845?\u1808? \u1813?\u1857?\u1821?\u1852?\u1826?\u1845?\u1808? \u1823?\u1857?\u1849?\u1808?\u1826?\u1845?\u1808? \u1813?\u1857?\u1816?\u1855?\u1826?\u1816? \u1792?\lang1048\f3\line\f0\fs24 24 l\u257?e \u7789?\u234?huu\u333?n \u7693?\u257?inyin \u7685?m\u275?s\u275?v \u7685?\u275?\'b7ep\u234?e e\u234?l\u257?e \u7693?\u257?in\u257?e cyen\u257?e \u7693?u\u333?n\'e2u .\line Nu \'eentor\'bai judeca\'fei \'eenf\'e3\'fei\'ba (\'een luare) \'een picioare, ci judeca\'fei justificare judec\'e3\'fei-i\ldblquote .\line\line\lang1114\f1\fs27\u1816?\u1845?\u1808?\u1825?\u1834?\u1821?\u1852?\u1826? \u1815?\u1864?\u1816?\u1842?\u1816? \u1808?\u1864?\u1826?\u1845?\u1835?\u1845?\u1808? \u1825?\u1852?\u1826? \u1808?\u1816?\u1855?\u1834?\u1849?\u1835?\u1824?\u1848?\u1825? \u1824?\u1842?\u1816? \u1815?\u1845?\u1826?\u1842?\u1816? \u1815?\u1842?\u1816? \u1813?\u1857?\u1810?\u1858?\u1845?\u1829?\u1849?\u1821?\u1826? \u1824?\u1825?\u1848?\u1833?\u1819?\u1842?\u1824? \u1792?\lang1048\f3\line\f0\fs24 25 u\u257?\'b7em\'e2ryin hu\u275?u en\u257?\'ba\u257?e m\u275?n Eu\u333?ry\'ba\'e2l\u234?m l\u275?\'b7u H\u257?n\u275?u Hu\u333? \u7693?\'ee\'b7b\u257?\'b7a\u234?in l\'ee\'b7m\u234?\'b7q\'e2\u7791?\u275?l .\line\'aai vorbi\'fei erau oameni din Ierusalim Lui: \'84\endash Iat\'e3 El denc\'e3uta\'fei omoar\'e2rii!\line\line\lang1114\f1\fs27\u1816?\u1815?\u1845?\u1808? \u1811?\u1857?\u1842?\u1824?\u1821?\u1845?\u1808?\u1821?\u1852?\u1836?\u1858? \u1825?\u1825?\u1842?\u1824?\u1848?\u1824? \u1816?\u1825?\u1848?\u1813?\u1857?\u1848?\u1825? \u1824?\u1845?\u1808? \u1808?\u1845?\u1825?\u1834?\u1821?\u1852?\u1826? \u1824?\u1849?\u1815? \u1813?\u1857?\u1842?\u1824?\u1825?\u1845?\u1808? \u1821?\u1852?\u1813?\u1858?\u1842?\u1829?\u1816? \u1833?\u1842?\u1835?\u1821?\u1852?\u1835?\u1842?\u1821?\u1826? \u1813?\u1857?\u1815?\u1845?\u1826?\u1842?\u1816? \u1835?\u1842?\u1834?\u1821?\u1852?\u1834?\u1845?\u1808?\u1821?\u1852?\u1836?\u1858? \u1825?\u1835?\u1821?\u1852?\u1818?\u1845?\u1808? \u1792?\lang1048\f3\line\f0\fs24 26 u\'ee\'b7h\u257?e \u289?\u275?li\u257?\'b7eiyt m\'ee\'b7m\u275?l\'eal u\'ee\'b7m\'ea\'f0\'eam l\u257?e e\u257?m\'e2ryin l\'ea\'b7h\'ee \'f0\u275?\'b7l\'ee\'b7m\u257?e iyd\u275?au q\u275?\'bayi\'bayin \'f0\'ee\'b7h\u257?n\u275?u \'ba\u275?ryir\u257?\'b7eiyt M\'e2\'bayi\u293?\u257?e .\line\'aai iat\'e3 public decuv\'e2nt\'e3 \'bai lucruri ne vorbi\'fei Lui de celor \'batiau b\'e3tr\'e2ni de acesta veridic Mesia. \line\line\lang1114\f1\fs27\u1808?\u1848?\u1824?\u1845?\u1808? \u1824?\u1815?\u1845?\u1826?\u1845?\u1808? \u1821?\u1845?\u1813?\u1858?\u1829?\u1821?\u1852?\u1826? \u1818?\u1864?\u1826?\u1842?\u1826? \u1825?\u1852?\u1826? \u1808?\u1842?\u1821?\u1825?\u1848?\u1823?\u1857?\u1845?\u1808? \u1815?\u1816?\u1855? \u1825?\u1835?\u1821?\u1852?\u1818?\u1845?\u1808? \u1813?\u1857?\u1849?\u1821?\u1826? \u1808?\u1848?\u1825?\u1842?\u1836?\u1858?\u1821? \u1813?\u1857?\u1845?\u1808?\u1836