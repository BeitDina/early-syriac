{\*\generator Msftedit 5.41.21.2513;}\viewkind4\uc1\pard\ltrpar\pagebb\sa240\sl100\slmult0\lang1048\f0\fs24\u7865?\lang1114\f1\u1810?\u1857?\u1845?\u1836?\u1858?\u1842?\u1834? \u1815?\u1845?\u1824?\u1849?\u1821?\u1826? \u1825?\u1815?\u1842?\u1824?\u1848?\u1823?\u1858? \u1815?\u1864?\u1816?\u1845?\u1808? \u1821?\u1852?\u1835?\u1816?\u1855?\u1829? \u1810?\u1857?\u1842?\u1811?\u1858?\u1824?\u1821?\u1852?\u1824?\u1845?\u1808? \u1824?\u1845?\u1808? \u1811?\u1857?\u1849?\u1821?\u1834? \u1832?\u1845?\u1810?\u1858?\u1849?\u1808? \u1815?\u1864?\u1816?\u1845?\u1808? \u1824?\u1842?\u1825?\u1815?\u1842?\u1824?\u1845?\u1823?\u1858?\u1816?\u1855? \u1810?\u1857?\u1821?\u1852?\u1815?\u1816?\u1855?\u1813?\u1858? \u1825?\u1848?\u1819?\u1852?\u1824? \u1813?\u1857?\u1821?\u1852?\u1815?\u1816?\u1855?\u1813?\u1858?\u1845?\u1821?\u1849?\u1808? \u1810?\u1857?\u1845?\u1829?\u1849?\u1821?\u1826? \u1815?\u1864?\u1816?\u1842?\u1816? \u1824?\u1825?\u1848?\u1833?\u1819?\u1824?\u1849?\u1815? \u1792? \lang1048\f0\line 1 \u7685?\u257?t\u275?r h\u257?l\'eain m\'ee\'b7h\u275?l\'eak hu\u257?e I\'ea\'bau\u333?a \u7685?\u275?\'b7G\'e2lyil\u257?e l\u257?e \u289?\'eair \u7789?\'e2b\u257?e hu\u257?e l\u275?\'b7m\'ee\'b7h\u275?l\u257?cu\u333? \u7685?y\'b7I\'e2hu\u333?d m\'ea\u7791?\u363?l \u7693?y\'b7i\'e2hu\u333?d\u257?i\u257?e \u7685?\u257?\'b7a\'eain hu\u275?u l\'ee\'b7m\'eaq\'e2\u7791?\'e2l\'ea\'b7H\'e2 .\line Urmare ace\'bati de-plecat este Ie\'baua \'een Galileia nu c\'e3ci dorin\'fe\'e3 este de plec\'e3rii \'een Iuda pentru iehudi\'feii \'een c\'e3utare erau omor\'e2rii-I.\line\line\lang1114\f2\fs27\u1816?\u1833?\u1842?\u1834?\u1821?\u1852?\u1810?\u1858? \u1815?\u1864?\u1816?\u1845?\u1808? \u1829?\u1842?\u1813?\u1858?\u1829?\u1849?\u1813?\u1858?\u1845?\u1808? \u1813?\u1857?\u1842?\u1825?\u1819?\u1842?\u1824?\u1849?\u1808? \u1813?\u1857?\u1821?\u1852?\u1815?\u1816?\u1855?\u1813?\u1858?\u1845?\u1821?\u1849?\u1808? \u1792?\lang1048\f3\line\f0\fs24 2 u\'ee\'b7q\u275?ryiv hu\u257?e a\u275?dayd\u257?e \u7693?\u275?\'b7m\'e2\u7791?\u275?l\'eae \u7693?y\'b7i\'e2hu\u333?d\u257?i\u257?e .\line\'aai aproape este s\'e3rb\'e3toare de colibi de i\'e2hudei (iudei).\cf1  \cf2\up8 Lev 23:33-43; Num 29:12-39; Deut 16:13-16;\cf0\up0  \line\line\lang1114\f1\fs27\u1816?\u1848?\u1808?\u1825?\u1842?\u1834?\u1816? \u1824?\u1849?\u1815? \u1808?\u1842?\u1818?\u1842?\u1816?\u1815?\u1864?\u1821? \u1824?\u1821?\u1852?\u1835?\u1816?\u1855?\u1829? \u1835?\u1842?\u1826?\u1845?\u1808? \u1824?\u1845?\u1823?\u1858? \u1825?\u1848?\u1823?\u1857?\u1845?\u1808? \u1816?\u1817?\u1848?\u1824? \u1824?\u1821?\u1852?\u1815?\u1816?\u1855?\u1813?\u1858? \u1813?\u1857?\u1826?\u1848?\u1818?\u1817?\u1816?\u1855?\u1826? \u1836?\u1857?\u1842?\u1824?\u1825?\u1821?\u1852?\u1813?\u1858?\u1842?\u1821?\u1823?\u1857? \u1829?\u1810?\u1858?\u1845?\u1813?\u1858?\u1849?\u1808? \u1813?\u1857?\u1829?\u1845?\u1810?\u1858?\u1848?\u1813?\u1858? \u1808?\u1842?\u1826?\u1864?\u1836?\u1857? \u1792?\lang1048\f3\line\f0\fs24 3 u\'ea\'b7em\u275?r\'e2u l\'ea\'b7H\'e2 e\u275?\u7717?u\u333?\'b7hi l\'ee\'b7I\'ea\'bau\u333?a \'aa\'ean\u257?e l\u257?\'b7K\'e2 m\'ea\'b7c\u257?e u\'ee\'b7z\'eal ly\'b7i\'e2hu\u333?d \u7693?\'ee\'b7n\'ea\'b7\u7717?\'e2zu\u333?n \u7789?\u275?lmyid\u275?i\'b7k\'ee a\u257?v\u7693?\u257?e \u7693?\u275?\'b7av\u275?d E\u275?n\'e2\u7789? .\line\'aai vorbeau Lui fra\'fei Lui Ie\'baualui: -An \'deie-\'dei de ajuns! \'aai mergi Iudeii de vor vedea ucenici-\'dei fapte de f\'e3ptuit Tu.\~  \line\~ \line\lang1114\f1\fs27\u1824?\u1842?\u1821?\u1836?\u1857? \u1811?\u1857?\u1849?\u1821?\u1834? \u1808?\u1864?\u1826?\u1845?\u1835? \u1813?\u1857?\u1829?\u1845?\u1810?\u1858?\u1848?\u1813?\u1858? \u1825?\u1848?\u1813?\u1857?\u1848?\u1825? \u1810?\u1857?\u1819?\u1816?\u1855?\u1835?\u1821?\u1845?\u1808? \u1816?\u1832?\u1845?\u1810?\u1858?\u1849?\u1808? \u1815?\u1816?\u1855? \u1813?\u1857?\u1842?\u1810?\u1858?\u1811?\u1858?\u1848?\u1824?\u1821?\u1845?\u1808? \u1826?\u1849?\u1815?\u1816?\u1849?\u1808? \u1808?\u1848?\u1826? \u1815?\u1845?\u1824?\u1849?\u1821?\u1826? \u1829?\u1845?\u1810?\u1858?\u1848?\u1813?\u1858? \u1808?\u1842?\u1826?\u1864?\u1836?\u1857? \u1818?\u1842?\u1816?\u1845?\u1808? \u1826?\u1842?\u1830?\u1858?\u1835?\u1845?\u1823?\u1858? \u1824?\u1829?\u1845?\u1824?\u1825?\u1845?\u1808? \u1792?\lang1048\f3\line\f0\fs24 4 l\u275?i\u7789? \u289?\'eair en\u257?\'ba \u7693?\u275?\'b7av\u275?d m\'ea\u7693?\'eam \u7685?\'ee\'b7\u7791?u\u333?\'bai\u257?e u\'ee\'b7\u7789?\u257?v\'eae hu\u333? \u7693?\u275?\'b7v\'ee\'b7g\'eali\u257?e n\'ea\'b7hu\'eae e\'ean h\u257?l\'eain a\u257?v\'ead E\u275?n\'e2\u7789? \u7717?ue n\u275?f\'e2\'ba\u257?\'b7K\'e2 l\'ee\'b7A\u257?lm\u257?e .\line Nici c\'e3ci om de f\'e3cut lucruri \'een secret, \'bai vrei el, publicul, va fi dac\'e3 ace\'bati obedesc Tu vie\'feuie\'bati sufletu-\'dei Lumii. \line\line\lang1114\f1\fs27\u1808?\u1845?\u1830?\u1858? \u1824?\u1845?\u1808? \u1811?\u1857?\u1849?\u1821?\u1834? \u1808?\u1842?\u1818?\u1842?\u1816?\u1815?\u1864?\u1821? \u1815?\u1842?\u1821?\u1825?\u1848?\u1826?\u1816? \u1815?\u1864?\u1816?\u1842?\u1816? \u1810?\u1857?\u1849?\u1815? \u1810?\u1857?\u1821?\u1852?\u1835?\u1816?\u1855?\u1829? \u1792?\lang1048\f3\line\f0\fs24 5 e\u257?\u402? l\u257?\i e\i0  \u289?\'eair e\u275?\u7717?u\u333?\'b7Hi h\u275?im\'eanu hu\u275?u \u7685?\'ea\'b7H\'e2 \u7685?\'ee\'b7I\'ea\'bau\u333?a .\line Idem nu c\'e3ci fra\'fei Lui credeau, erau \'een El, \'een Ie\'baua.\line\line\lang1114\f1\fs27\u1808?\u1845?\u1825?\u1842?\u1834? \u1824?\u1815?\u1816?\u1855?\u1826? \u1821?\u1852?\u1835?\u1816?\u1855?\u1829? \u1817?\u1842?\u1810?\u1858?\u1826?\u1821? \u1813?\u1857?\u1821?\u1852?\u1824?\u1821? \u1829?\u1813?\u1858?\u1842?\u1825?\u1845?\u1808? \u1824?\u1815?\u1845?\u1835?\u1845?\u1808? \u1824?\u1845?\u1808? \u1825?\u1819?\u1845?\u1808? \u1817?\u1842?\u1810?\u1858?\u1826?\u1823?\u1858?\u1816?\u1855?\u1826? \u1813?\u1857?\u1849?\u1821?\u1826? \u1813?\u1857?\u1821?\u1852?\u1824?\u1823?\u1858?\u1816?\u1855?\u1826? \u1810?\u1857?\u1823?\u1858?\u1852?\u1824? \u1829?\u1848?\u1813?\u1857?\u1845?\u1826? \u1825?\u1819?\u1842?\u1821?\u1842?\u1810?\u1858? \u1792?\lang1048\f3\line\f0\fs24 6 e\u257?m\u275?r l\'ee\'b7hu\u333?n I\'ea\'bau\u333?a Z\u275?v\'e2n\'b7I \u7693?yil\'b7I ad\u275?\'b7m\u257?e l\'ee\'b7h\u257?\'ba\u257?e l\u257?e m\'ee\'b7\u7791?\u257?e Z\u275?v\'e2n\'b7cu\u333?n \u7693?\'eain \u7693?yil\'b7cu\u333?n \u7685?\'ee\'b7c\u363?l a\'ea\u7693?\u257?n m\'ee\'b7\u7791?\u275?i\u275?v .\line Spune lor Ie\'baua:\~  \endash Vreme-Mi de-\'eensu-Mi p\'e2n\'e3-ce acumai nu \'eentins\'e3! Vreme-voastr\'e3, dar, d\'e2n\'baiv\'e3 \'een orice vreme \'eentins\'e3.\line (Not\'e3: aedan, vezi \'bai: Ap. 12:14)\line\~ \line\lang1114\f1\fs27\u1824?\u1845?\u1808? \u1825?\u1848?\u1835?\u1823?\u1857?\u1842?\u1818? \u1829?\u1845?\u1824?\u1825?\u1845?\u1808? \u1824?\u1825?\u1848?\u1827?\u1826?\u1845?\u1823?\u1858?\u1816?\u1855?\u1826? \u1824?\u1821?\u1852? \u1813?\u1857?\u1849?\u1821?\u1826? \u1827?\u1845?\u1826?\u1849?\u1808? \u1825?\u1848?\u1819?\u1852?\u1824? \u1813?\u1857?\u1848?\u1808?\u1826?\u1845?\u1808? \u1825?\u1842?\u1827?\u1815?\u1848?\u1813?\u1858? \u1808?\u1864?\u1826?\u1845?\u1808? \u1829?\u1824?\u1842?\u1816?\u1815?\u1864?\u1821? \u1813?\u1857?\u1842?\u1829?\u1810?\u1858?\u1845?\u1813?\u1858?\u1842?\u1816?\u1815?\u1864?\u1821? \u1810?\u1857?\u1821?\u1852?\u1835?\u1821?\u1852?\u1826? \u1808?\u1848?\u1826?\u1816?\u1855?\u1826? \u1792?\lang1048\f3\line\f0\fs24 7 l\u257?e m\'ea\'b7\'ba\'e2c\u275?\u7717? a\u257?lm\u257?e l\'ee\'b7m\'ea\'b7s\'e2n\u257?\'b7cu\u333?n Ly\'b7I \u7693?\'eain s\u257?n\'eae m\'ea\u7791?\u363?l \u7693?\'ea\'b7En\u257?e m\u275?\'b7s\'e2h\'ead E\'ean\u257?e al\u275?u\'b7Hi \u7693?\'ee\'b7a\u275?v\u7693?\u275?u\'b7Hi \u7685?yi\'bayin e\'eanu\u333?n .\line Nu de g\'e3sit lume de ur\'e2rii-vou\'e3! Mie-Mi, dar, ure\'bate pentru de Eu demartor Eu asupra Lui de obedien\'fei Lui vicleni nou\'e3.\~  \line\line\lang1114\f1\fs27\u1808?\u1842?\u1826?\u1864?\u1836?\u1857?\u1816?\u1855?\u1826? \u1827?\u1842?\u1833?\u1816? \u1824?\u1829?\u1842?\u1813?\u1858?\u1829?\u1849?\u1813?\u1858?\u1845?\u1808? \u1815?\u1845?\u1826?\u1845?\u1808? \u1808?\u1848?\u1826?\u1845?\u1808? \u1824?\u1845?\u1808? \u1827?\u1845?\u1824?\u1848?\u1833? \u1808?\u1864?\u1826?\u1845?\u1808? \u1815?\u1845?\u1835?\u1845?\u1808? \u1824?\u1829?\u1842?\u1813?\u1858?\u1829?\u1849?\u1813?\u1858?\u1845?\u1808? \u1815?\u1845?\u1826?\u1845?\u1808? \u1825?\u1848?\u1819?\u1852?\u1824? \u1813?\u1857?\u1817?\u1842?\u1810?\u1858?\u1826?\u1845?\u1808? \u1813?\u1857?\u1821?\u1852?\u1824?\u1821? \u1824?\u1845?\u1808? \u1829?\u1813?\u1858?\u1842?\u1823?\u1857?\u1821?\u1852?\u1824? \u1835?\u1824?\u1848?\u1825? \u1792?\lang1048\f3\line\f0\fs24 8 e\u275?n\'e2\u7789?u\u333?n s\u275?qu l\u275?\'b7d\'ee\'b7ayd\u257?e h\u257?n\u257?e E\'ean\u257?e l\u257?e s\'e2l\'eaq E\'ean\u257?e h\u257?\'ba\u257?e l\u275?\'b7d\'ee\'b7ayd\u257?e h\u257?n\u257?e m\'ea\u7791?\u363?l \u7693?\'ee\'b7z\u275?vn\u257?e \u7693?y\'b7i\'b7l\'ee\'b7i l\u257?e ad\u275?cyil \'ba\u275?l\'eam .\line Voi merge\'fei praznicului acesta, Eu nu merg, Eu acum pr\'e3znicului acesta pentru c\'e3 vreme de-\'eensu-Mi nu p\'e2n\'e3-acum ajunge. \line\line\lang1114\f1\fs27\u1815?\u1845?\u1824?\u1849?\u1821?\u1826? \u1808?\u1848?\u1825?\u1842?\u1834? \u1816?\u1830?\u1858?\u1845?\u1835? \u1824?\u1849?\u1815? \u1810?\u1857?\u1842?\u1811?\u1858?\u1824?\u1821?\u1852?\u1824?\u1845?\u1808? \u1792?\lang1048\f3\line\f0\fs24 9 h\u257?l\'eain e\u257?m\u275?r u\'ee\'b7f\u257?\'ba l\'ea\'b7H\'e2 \u7685?\u275?\'b7G\'e2lyil\u257?e .\line Ace\'bati vorbesc \'bai r\'e3m\'e2n Lui \'een Galileea.\line\line\lang1114\f1\fs27\u1823?\u1857?\u1842?\u1813?\u1858? \u1813?\u1857?\u1849?\u1821?\u1826? \u1827?\u1824?\u1848?\u1833?\u1816? \u1808?\u1842?\u1818?\u1842?\u1816?\u1815?\u1864?\u1821? \u1824?\u1829?\u1842?\u1813?\u1858?\u1829?\u1849?\u1813?\u1858?\u1845?\u1808? \u1815?\u1845?\u1821?\u1813?\u1857?\u1849?\u1821?\u1826? \u1808?\u1845?\u1830?\u1858? \u1815?\u1816?\u1855? \u1827?\u1824?\u1848?\u1833? \u1824?\u1845?\u1808? \u1810?\u1857?\u1811?\u1858?\u1848?\u1824?\u1821?\u1845?\u1808? \u1808?\u1848?\u1824?\u1845?\u1808? \u1808?\u1842?\u1821?\u1823?\u1858? \u1813?\u1857?\u1842?\u1810?\u1858?\u1819?\u1816?\u1855?\u1835?\u1821?\u1845?\u1808? \u1792?\lang1048\f3\line\f0\fs24 10 c\u275?d \u7693?\'eain s\'e2l\'eaqu e\u275?\u7717?u\u333?\'b7Hi l\'ee\'b7a\u275?d\'b7ayd\u257?e h\u257?i\u7693?\'eain e\u257?\u402? hu\u333? s\'e2l\'eaq l\u257?e \u7685?\'ee\'b7g\'eali\u257?e e\'eal\u257?e e\u275?ik \u7693?\u275?\'b7v\'ee\u7791?u\u333?\'bai\u257?e .\line C\'e2nd, dar, mergeau fra\'fei Lui p\'e2n\'e3 s\'e3rb\'e3torii, dar, idem El merge nu \'een public ci cum de secret. \line\line\lang1114\f1\fs27\u1821?\u1852?\u1815?\u1816?\u1855?\u1813?\u1858?\u1845?\u1821?\u1849?\u1808? \u1813?\u1857?\u1849?\u1821?\u1826? \u1810?\u1857?\u1845?\u1829?\u1849?\u1821?\u1826? \u1815?\u1864?\u1816?\u1842?\u1816? \u1824?\u1849?\u1815? \u1810?\u1857?\u1829?\u1842?\u1813?\u1858?\u1829?\u1849?\u1813?\u1858?\u1845?\u1808? \u1816?\u1845?\u1808?\u1825?\u1834?\u1821?\u1852?\u1826? \u1815?\u1864?\u1816?\u1842?\u1816? \u1808?\u1842?\u1821?\u1823?\u1857?\u1842?\u1816? \u1815?\u1842?\u1816? \u1792?\lang1048\f3\line\f0\fs24 11 iyhu\u333?d\u257?i\u257?e \u7693?\'eain \u7685?\u257?\'b7a\'eain hu\u275?u l\'ea\'b7h\'e2 \u7685?\'ee\'b7a\u275?dayd\u257?e u\u257?\'b7em\'e2ryin hu\u275?u E\u275?ic\u275?u Hu\u333? .\line I\'e2hudei, dar, \'een c\'e3utare erau Lui \'een s\'e3rb\'e3toare \'bai vorbi\'fei erau: -Unde-I El? \line\line\lang1114\f1\fs27\u1816?\u1834?\u1848?\u1819?\u1826?\u1845?\u1808? \u1827?\u1842?\u1811?\u1857?\u1821?\u1852?\u1845?\u1808?\u1808? \u1825?\u1848?\u1819?\u1852?\u1824?\u1845?\u1836?\u1858?\u1849?\u1815? \u1808?\u1821?\u1852?\u1836?\u1858? \u1815?\u1864?\u1816?\u1845?\u1808? \u1810?\u1857?\u1823?\u1858?\u1848?\u1826?\u1835?\u1845?\u1808? \u1808?\u1821?\u1852?\u1836?\u1858? \u1815?\u1864?\u1816?\u1842?\u1816? \u1811?\u1857?\u1849?\u1821?\u1834? \u1813?\u1857?\u1845?\u1808?\u1825?\u1834?\u1821?\u1852?\u1826? \u1813?\u1857?\u1819?\u1845?\u1810?\u1858? \u1815?\u1864?\u1816?\u1855? \u1816?\u1842?\u1808?\u1864?\u1818?\u1834?\u1845?\u1826?\u1849?\u1808? \u1808?\u1845?\u1825?\u1834?\u1821?\u1852?\u1826? \u1815?\u1864?\u1816?\u1842?\u1816? \u1824?\u1845?\u1808? \u1808?\u1848?\u1824?\u1845?\u1808? \u1825?\u1842?\u1819?\u1829?\u1849?\u1808? \u1824?\u1829?\u1842?\u1825?\u1845?\u1808? \u1792?\lang1048\f3\line\f0\fs24 12 u\'ee\'b7r\'ea\u7791?\'e2n\u257?e s\u275?\u289?yi\u257?ee m\'ea\u7791?\u363?l\u257?t\'ea\'b7h\'ee eyit hu\u257?e \u7685?\'ee\'b7c\'ean\'e2\'ba\u257?e eyit hu\u275?u \u289?\'eair \u7693?\u257?\'b7em\'e2ryin \u7693?\'ee\'b7\u7791?\u257?v Hu\u333? u\u275?\'b7e\u7717?ryn\u257?e e\u257?m\'e2ryin hu\u275?u L\u257?e e\'eal\u257?e m\u275?\u7791?a\'eae l\'ee\'b7a\u275?m\u257?e .\line\'aai murmurare mult\'e3 deoarece-I tot este \'een adunare (mul\'feime) tot erau c\'e3ci de vorbi\'fei: De bun El! \'aai afar\'e3 vorbi\'fei erau: \endash Nu ci \'een\'bael\'e3tor poporului!\line\~ \line\lang1114\f1\fs27\u1824?\u1845?\u1808? \u1813?\u1857?\u1849?\u1821?\u1826? \u1808?\u1864?\u1826?\u1845?\u1835? \u1811?\u1857?\u1842?\u1824?\u1821?\u1845?\u1808?\u1821?\u1852?\u1836?\u1858? \u1825?\u1825?\u1842?\u1824?\u1848?\u1824? \u1815?\u1864?\u1816?\u1845?\u1808? \u1829?\u1824?\u1842?\u1816?\u1815?\u1864?\u1821? \u1825?\u1848?\u1819?\u1852?\u1824? \u1813?\u1857?\u1848?\u1818?\u1824?\u1836?\u1858?\u1845?\u1808? \u1813?\u1857?\u1821?\u1852?\u1815?\u1816?\u1855?\u1813?\u1858?\u1845?\u1821?\u1849?\u1808? \u1792?\lang1048\f3\line\f0\fs24 13 l\u257?e \u7693?\'eain en\u257?\'ba \u289?\u275?li\u257?\'b7eiyt m\'ee\'b7m\u275?l\'eal hu\u257?e al\u275?u\'b7Hi m\'ea\u7791?\u363?l \u7693?\'ea\'b7\u7717?\'e2lt\u257?e \u7693?y\'b7i\'e2hu\u333?d\u257?i\u257?e .\line Nu, dar, ins public decuvinte sunt asupra-I pentru de-nfricare de iudei.\line\line\lang1114\f1\fs27\u1823?\u1857?\u1842?\u1813?\u1858? \u1813?\u1857?\u1849?\u1821?\u1826? \u1830?\u1857?\u1824?\u1842?\u1811?\u1858?\u1816? \u18